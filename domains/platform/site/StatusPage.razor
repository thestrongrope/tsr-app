@* The API's status as it was when this site was built. A static page cannot show it live. *@
<main class="min-h-screen bg-gradient-to-br from-gray-50 to-blue-50 dark:from-gray-950 dark:to-gray-900">
    <div class="max-w-4xl mx-auto px-8 py-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4">Status</h1>
        <p class="text-gray-900 dark:text-gray-100 leading-relaxed mb-4">When this site was built, the API answered: <strong>@Health.Status</strong>.</p>
    </div>
</main>

@code {
    [Parameter, EditorRequired]
    public Health Health { get; set; } = default!;
}
