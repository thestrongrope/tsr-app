<Project Sdk="Microsoft.NET.Sdk">
  <!-- access (AuthZ): what a caller may do, and in which scope. Depends on shared only. -->
  <PropertyGroup>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../../shared/api/Tsr.Shared.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests sit next to the code they test; tests/ compiles them. -->
    <Compile Remove="**/*.Tests.cs" />
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine, rules and slices are internal; this domain's unit tests and the database tests may see them. -->
    <InternalsVisibleTo Include="Tsr.Access.Api.Tests" />
    <InternalsVisibleTo Include="Tsr.Db.Tests" />
  </ItemGroup>
</Project>
