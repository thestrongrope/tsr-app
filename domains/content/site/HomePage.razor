@* The home page, as tsr-web's app/page.tsx and components/CategoryCard.tsx write it, in the same classes and order. The data was read
   from the public routes when the site was built (ContentSite.PagesAsync); nothing here is a rule. Both search boxes are plain
   forms; site.js makes the article search send the trimmed text and no empty q. A category card's subcategories are written open, with their toggle button hidden: a reader without scripts sees every
   link. site.js hides the lists, shows the buttons and opens and closes a card. The "New" badge of the present site is not written:
   it depends on today's date, and this page is built once. The Arabic verse has dir="rtl" as on the present site and no lang
   attribute: lang="ar" would turn every block around it (the stylesheet's div:has([lang="ar"]) rule). *@
<main class="min-h-screen bg-gradient-to-br from-gray-50 to-blue-50 dark:from-gray-950 dark:to-gray-900">
    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="mb-6 shadow-xl rounded-3xl overflow-hidden border border-blue-200/70 dark:border-blue-900/70 bg-gradient-to-r from-blue-100/85 via-blue-50 to-purple-100/85 dark:from-blue-950/50 dark:via-slate-900/40 dark:to-purple-900/60">
            <div class="px-5 py-6 md:px-8 md:py-8 text-center">
                <p class="text-2xl md:text-4xl text-gray-800 dark:text-gray-100 font-bold mb-2 leading-relaxed" dir="rtl">
                    وَاعْتَصِمُوا بِحَبْلِ اللهِ جَمِيعًا وَلَا تَفَرَّقُوا
                </p>
                <p class="text-2xl md:text-4xl text-gray-800 dark:text-gray-100 font-bold mb-2 leading-relaxed">
                    &ldquo;And hold firmly to the rope of Allah all together and do not be divided&rdquo;
                </p>
                <p class="text-sm md:text-base text-gray-600 dark:text-gray-300 font-semibold">
                    Surah Aal-e-Imran 3:103
                </p>
            </div>
            <div class="border-t border-white/70 dark:border-slate-800"></div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-0 md:gap-px bg-white/5 dark:bg-slate-900/20">
                <a href="/accreditation#naba-cultural" class="group flex w-full items-center gap-3 bg-white/80 px-4 py-4 text-left transition-all hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/60 dark:bg-slate-900/70 dark:hover:bg-slate-900">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full border border-blue-200/80 bg-white overflow-hidden shrink-0">
                        <img src="/uploads/naba-accreditation.png" alt="Naba Cultural Organization" width="48" height="48" class="object-contain">
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-wide text-blue-700 dark:text-blue-300/80">Accredited by</p>
                        <p class="text-sm md:text-base font-semibold text-gray-900 dark:text-gray-100">Naba Cultural Organization, I.R. Iran</p>
                        <p class="text-xs md:text-sm text-gray-700 dark:text-gray-300">Official learning resource</p>
                    </div>
                </a>
                <a href="/accreditation#maulana-zeeshan" class="group flex w-full items-center gap-3 bg-white/80 px-4 py-4 text-left transition-all hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-500/60 dark:bg-slate-900/70 dark:hover:bg-slate-900">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full border border-purple-200/80 bg-white overflow-hidden shrink-0">
                        <img src="/uploads/maulana-zeeshan-haider-zaidi.jpg" alt="Maulana Zeeshan Haider Zaidi" width="48" height="48" class="object-cover rounded-full">
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-wide text-purple-700 dark:text-purple-300/80">Endorsed by</p>
                        <p class="text-sm md:text-base font-semibold text-gray-900 dark:text-gray-100">Maulana Zeeshan Haider Zaidi</p>
                        <p class="text-xs md:text-sm text-gray-700 dark:text-gray-300">Vakil of Grand Ayatullah Shaikh Basheer Najafi (d.z.a.)</p>
                    </div>
                </a>
                <a href="/accreditation#shaikh-kazim" class="group flex w-full items-center gap-3 bg-white/80 px-4 py-4 text-left transition-all hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60 dark:bg-slate-900/70 dark:hover:bg-slate-900">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full border border-emerald-200/80 bg-white overflow-hidden shrink-0">
                        <img src="/uploads/kazim-sahab.png" alt="Shaikh Mohammad Kazim" width="48" height="48" class="object-cover rounded-full">
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-wide text-emerald-700 dark:text-emerald-300/80">Endorsed by</p>
                        <p class="text-sm md:text-base font-semibold text-gray-900 dark:text-gray-100">Maulana Shaikh Kazim Alam al-Hoda</p>
                        <p class="text-xs md:text-sm text-gray-700 dark:text-gray-300">Principal, Hawzah Ilmiyyah Isna Ashariyyah, Kargil</p>
                    </div>
                </a>
            </div>
        </div>

        @if (Latest.Count > 0)
        {
            <div class="mb-8">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100 flex items-center gap-2">
                        <span class="inline-block w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                        Latest Articles
                    </h2>
                    <a href="/articles/" class="text-sm text-blue-600 dark:text-blue-400 hover:underline font-medium flex items-center gap-1">
                        View all
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </a>
                </div>
                <div class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide">
                    @foreach (var article in Latest)
                    {
                        <a href="/articles/@article.Slug/" class="group flex-shrink-0 w-72 snap-start bg-white dark:bg-gray-900 rounded-xl shadow-md border border-gray-200 dark:border-gray-800 overflow-hidden hover:shadow-xl hover:scale-[1.02] transition-all duration-300">
                            <div class="p-4">
                                @if (article.Category is not null)
                                {
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="text-xs bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded-full font-medium truncate max-w-[120px]">@article.Category</span>
                                    </div>
                                }
                                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 line-clamp-2 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                                    @article.Title
                                </h3>
                                @if (article.Date is not null)
                                {
                                    <p class="text-xs text-gray-500 dark:text-gray-400">@article.Date</p>
                                }
                            </div>
                        </a>
                    }
                </div>
            </div>
        }

        <div class="mb-8">
            <div class="max-w-2xl mx-auto text-center mb-6">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-2">Search Articles</h2>
                <p class="text-gray-600 dark:text-gray-300">Find articles and resources across all topics</p>
            </div>
            <div class="max-w-md mx-auto">
                <form action="/articles/" method="get" class="relative" data-article-search>
                    <div class="relative">
                        <input type="text" name="q" placeholder="Search articles..." aria-label="Search articles" class="w-full px-4 py-3 pl-12 pr-12 text-gray-900 dark:text-gray-100 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm transition-colors">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-400">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (Cards.Count > 0)
        {
            <div class="h-px w-full bg-blue-200/70 dark:bg-blue-900/60 mb-8"></div>
            <div class="mb-12">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var card in Cards)
                    {
                        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-md border border-gray-200 dark:border-gray-800 overflow-hidden" data-category-card="@card.Slug">
                            <div class="p-4">
                                <div class="flex items-center justify-between">
                                    <a href="/articles/?category=@card.Slug" class="flex-1 group">
                                        <div class="flex items-center justify-between">
                                            <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                                                @card.Title
                                            </h3>
                                            <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-sm font-bold ml-3">
                                                @card.Count
                                            </span>
                                        </div>
                                    </a>
                                    @if (card.Children.Count > 0)
                                    {
                                        <button type="button" data-category-card-toggle="@card.Slug" class="ml-2 p-2 text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors" aria-label="Collapse" hidden>
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 transition-transform rotate-180">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                            </svg>
                                        </button>
                                    }
                                </div>
                                @if (card.Description is not null)
                                {
                                    <p class="text-xs text-gray-600 dark:text-gray-400 mt-2 leading-relaxed">@card.Description</p>
                                }
                            </div>
                            @if (card.Children.Count > 0)
                            {
                                <div data-category-card-list class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50 px-4 py-3">
                                    <ul class="space-y-1">
                                        @foreach (var child in card.Children)
                                        {
                                            <li>
                                                <a href="/articles/?category=@child.Slug" class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-white dark:hover:bg-gray-800 transition-colors group">
                                                    <span class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 font-medium">
                                                        &#x21B3; @child.Title
                                                    </span>
                                                    <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 bg-gray-200 dark:bg-gray-700 px-2 py-1 rounded-full">
                                                        @child.Count
                                                    </span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <div class="mb-12">
            <form action="/lectures" method="get">
                <label for="lecture-search" class="sr-only">Search lectures</label>
                <div class="relative">
                    <input id="lecture-search" type="text" name="q" placeholder="Search the lecture library &#x2014; topics, names, questions&#x2026;" class="w-full px-4 py-4 pl-12 pr-28 text-gray-900 dark:text-gray-100 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm transition-colors">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <button type="submit" class="absolute inset-y-2 right-2 px-5 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700 transition-colors">Search</button>
                </div>
            </form>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                Jump straight to the moment &#x2014; results link to the exact timestamp in the video.
                <a href="/lectures" class="text-blue-600 dark:text-blue-400 hover:underline">Browse all lectures &#x2192;</a>
            </p>
        </div>

        @if (Videos.Count > 0)
        {
            <div class="mb-12">
                <div class="flex items-center justify-between mb-10">
                    <h2 class="text-4xl font-bold text-gray-800 dark:text-gray-100">Latest Videos</h2>
                    <a href="@Home.ChannelUrl" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 font-semibold transition-colors">
                        View Channel
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>
                    </a>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    @foreach (var video in Videos)
                    {
                        <a href="https://www.youtube.com/watch?v=@video.VideoId" target="_blank" rel="noopener noreferrer" class="group block bg-white dark:bg-gray-900 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-800 overflow-hidden hover:shadow-2xl hover:scale-[1.02] transition-all duration-300">
                            <div class="relative aspect-video bg-gray-100 dark:bg-gray-800">
                                @if (video.Thumbnail is not null)
                                {
                                    <img src="@video.Thumbnail" alt="@video.Title" class="w-full h-full object-cover">
                                }
                                else
                                {
                                    <div class="flex items-center justify-center h-full">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-16 h-16 text-red-500">
                                            <path d="M21.593 7.203a2.506 2.506 0 00-1.762-1.766C18.265 5.007 12 5 12 5s-6.264-.007-7.831.404a2.56 2.56 0 00-1.766 1.778c-.413 1.566-.417 4.814-.417 4.814s-.004 3.264.406 4.814c.23.857.905 1.534 1.763 1.765 1.582.43 7.83.437 7.83.437s6.265.007 7.831-.403a2.515 2.515 0 001.767-1.763c.414-1.565.417-4.812.417-4.812s.02-3.265-.407-4.831zM9.996 15.005l.005-6 5.207 3.005-5.212 2.995z" />
                                        </svg>
                                    </div>
                                }
                                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                                    <div class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="white" viewBox="0 0 24 24" class="w-8 h-8 ml-1">
                                            <path d="M8 5v14l11-7z" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="p-4">
                                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors line-clamp-2 mb-2">
                                    @video.Title
                                </h3>
                                @if (video.Description is not null)
                                {
                                    <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mb-3">@video.Description</p>
                                }
                                <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-500">
                                    <span>@video.Date</span>
                                    @if (video.Views is not null)
                                    {
                                        <span>@video.Views</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</main>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<HomeArticle> Latest { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<FilterCategory> Cards { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<HomeVideo> Videos { get; set; } = default!;
}
