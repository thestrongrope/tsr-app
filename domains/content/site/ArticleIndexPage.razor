@* The list of published articles, newest first, as the API returns them: the markup and classes of tsr-web's
   app/articles/page.tsx, components/ArticlesList.tsx and components/CategoryFilter.tsx. The search box is not here yet.
   Written for a reader without scripts: every card, "All Articles" over them, the panel open. What a filter shows (the
   reset link, the nothing-found box, the chips) is written hidden. site.js reads ?category= and ?tag=, hides the cards that
   do not match (each card's data-categories and data-tags, written when the site was built), words the heading from
   data-article-filters (which holds every sentence it shows, ArticleFilters.cs) and marks the active link; each link's other
   looks are in its data- attributes. *@
<main class="min-h-screen bg-gradient-to-br from-gray-50 to-blue-50 dark:from-gray-950 dark:to-gray-900" data-article-list data-article-filters="@FilterData" data-parent-class="text-3xl opacity-70">
    <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="mb-12 text-center">
            <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-blue-600 to-purple-600 dark:from-blue-400 dark:to-purple-400 bg-clip-text text-transparent" data-filter-heading>@ArticleFilters.AllArticles</h1>
            <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto" data-filter-description>@ArticleFilters.DefaultDescription</p>
            <div class="mt-4" data-filter-reset hidden>
                <a href="/articles/" class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:underline">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>
                    View all articles
                </a>
            </div>
        </div>

        @if (Panel.Count > 0)
        {
            <div class="mb-6 bg-white dark:bg-gray-900 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-800 overflow-hidden">
                <button type="button" class="w-full px-6 py-4 flex items-center justify-between text-left hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors" data-filter-toggle aria-expanded="true">
                    <div class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-500 dark:text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                        </svg>
                        <span class="text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider">Filter by Category</span>
                        <span class="px-3 py-1 bg-gradient-to-r from-blue-600 to-purple-600 text-white text-sm font-medium rounded-full" data-filter-chip="category" hidden></span>
                        <span class="px-3 py-1 bg-gradient-to-r from-green-600 to-teal-600 text-white text-sm font-medium rounded-full" data-filter-chip="tag" hidden></span>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-500 dark:text-gray-400 transition-transform duration-200 rotate-180" data-filter-arrow>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>

                <div class="px-6 pb-6 pt-2 border-t border-gray-100 dark:border-gray-800" data-filter-body>
                    <div class="space-y-3">
                        <a href="/articles/" class="block px-5 py-2.5 rounded-xl font-medium transition-all bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-md" data-filter-link data-filter-all
                           data-current-class="block px-5 py-2.5 rounded-xl font-medium transition-all bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-md"
                           data-none-class="block px-5 py-2.5 rounded-xl font-medium transition-all bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700">All Articles</a>

                        @foreach (var parent in Panel)
                        {
                            <div class="space-y-2">
                                <div class="flex items-center gap-2">
                                    <a href="/articles/?category=@parent.Slug" class="flex-1 px-5 py-2.5 rounded-xl font-medium transition-all bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700" data-filter-link data-category="@parent.Slug" data-children="@ArticleFilters.Tokens(parent.Children.Select(child => child.Slug))"
                                       data-current-class="flex-1 px-5 py-2.5 rounded-xl font-medium transition-all bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-md"
                                       data-ancestor-class="flex-1 px-5 py-2.5 rounded-xl font-medium transition-all bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 border-2 border-blue-200 dark:border-blue-800"
                                       data-none-class="flex-1 px-5 py-2.5 rounded-xl font-medium transition-all bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700">
                                        <span class="flex items-center justify-between">
                                            <span>@parent.Title</span>
                                            <span class="text-xs opacity-70 ml-2">(@parent.Count)</span>
                                        </span>
                                    </a>

                                    @if (parent.Children.Count > 0)
                                    {
                                        <button type="button" class="p-2 rounded-lg transition-all bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700" aria-label="Collapse subcategories" data-subcategory-toggle="@parent.Slug" data-children="@ArticleFilters.Tokens(parent.Children.Select(child => child.Slug))" hidden
                                                data-active-class="p-2 rounded-lg transition-all bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300"
                                                data-none-class="p-2 rounded-lg transition-all bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 transition-transform duration-200 rotate-180">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                            </svg>
                                        </button>
                                    }
                                </div>

                                @if (parent.Children.Count > 0)
                                {
                                    <div class="ml-6 pl-4 border-l-2 border-gray-200 dark:border-gray-700 space-y-2" data-subcategories="@parent.Slug">
                                        @foreach (var child in parent.Children)
                                        {
                                            <a href="/articles/?category=@child.Slug" class="block px-4 py-2 rounded-lg text-sm font-medium transition-all bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 border border-gray-200 dark:border-gray-700" data-filter-link data-category="@child.Slug" data-children=""
                                               data-current-class="block px-4 py-2 rounded-lg text-sm font-medium transition-all bg-gradient-to-r from-purple-500 to-pink-500 text-white shadow-md"
                                               data-none-class="block px-4 py-2 rounded-lg text-sm font-medium transition-all bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 border border-gray-200 dark:border-gray-700">
                                                <span class="flex items-center justify-between">
                                                    <span>↳ @child.Title</span>
                                                    <span class="text-xs opacity-70 ml-2">(@child.Count)</span>
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Articles.Count == 0)
        {
            <div class="text-center py-20 bg-white dark:bg-gray-900 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-800">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 mx-auto mb-4 text-gray-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
                <p class="text-xl text-gray-600 dark:text-gray-400 font-medium">No articles found</p>
            </div>
        }
        else
        {
            <div class="text-center py-20 bg-white dark:bg-gray-900 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-800" data-filter-none hidden>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 mx-auto mb-4 text-gray-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
                <p class="text-xl text-gray-600 dark:text-gray-400 font-medium" data-filter-none-title></p>
                <p class="text-sm text-gray-500 dark:text-gray-500 mt-2" data-filter-none-hint></p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-article-cards>
                @foreach (var article in Articles)
                {
                    <a href="/articles/@article.Slug/" class="group block p-6 bg-white dark:bg-gray-900 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-800 hover:shadow-2xl hover:scale-[1.02] transition-all duration-300" data-categories="@ArticleFilters.Tokens(article.Categories ?? [])" data-tags="@ArticleFilters.Tokens((article.Tags ?? []).Select(ArticleFilters.Slugify))">
                        @if (article.Categories is { Count: > 0 })
                        {
                            <div class="flex flex-wrap gap-2 mb-3">
                                @foreach (var slug in article.Categories)
                                {
                                    <span class="text-xs px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-md font-medium">@CategoryTitle(slug)</span>
                                }
                            </div>
                        }

                        <h2 class="text-xl font-bold mb-3 line-clamp-2 text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">@TitleText.Decode(article.Title)</h2>

                        @if (article.Excerpt is not null)
                        {
                            <p class="text-gray-600 dark:text-gray-400 line-clamp-3 text-sm leading-relaxed mb-3">@TitleText.Decode(article.Excerpt)</p>
                        }
                    </a>
                }
            </div>
        }
    </div>
</main>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ArticleSummary> Articles { get; set; } = default!;

    /// <summary>Every category by its slug, to show a title for a slug.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, Category> Categories { get; set; } = default!;

    /// <summary>The panel's entries: see <see cref="ArticleFilters.Panel"/>.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<FilterCategory> Panel { get; set; } = default!;

    /// <summary>The headings' data as JSON: see <see cref="ArticleFilters.DataJson"/>.</summary>
    [Parameter, EditorRequired]
    public string FilterData { get; set; } = default!;

    private string CategoryTitle(string slug) =>
        Categories.TryGetValue(slug, out var category) ? TitleText.Decode(category.Title) : slug;
}
