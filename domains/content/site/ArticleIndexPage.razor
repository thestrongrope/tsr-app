@* The list of published articles, newest first, as the API returns them. *@
<h1>Articles</h1>
@if (Articles.Count == 0)
{
    <p>No articles yet.</p>
}
else
{
    <ul>
        @foreach (var article in Articles)
        {
            <li><a href="/articles/@article.Slug/">@article.Title</a></li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Article> Articles { get; set; } = default!;
}
