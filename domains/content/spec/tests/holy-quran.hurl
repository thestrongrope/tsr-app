# GET /holy-quran contract: the 114 surahs in id order, every field byte for byte as PHP holds them (the Arabic names with their marks). Any signed-in member, no permission. Runs against any implementation.
# Variables: base_url, auth_edge_plain. db/synthetic/edge-fixtures.sql loads the same 114 rows into the test stack. The per-row asserts were generated from PHP's own answer.

# 1. Without sign-in: 401
GET {{base_url}}/holy-quran
HTTP 401
[Asserts]
jsonpath "$.detail" matches /\S/

# 2. A plain member gets all 114, in order, four fields each
GET {{base_url}}/holy-quran
Authorization: {{auth_edge_plain}}
HTTP 200
[Asserts]
header "Content-Type" startsWith "application/json"
jsonpath "$" count == 114
jsonpath "$[0].*" count == 4
jsonpath "$[113].*" count == 4
jsonpath "$[0].id" == 1
jsonpath "$[0].surah" == "Al-Fatiha"
jsonpath "$[0].arabic" == "ٱلْفَاتِحَة"
jsonpath "$[0].verses" == 7
jsonpath "$[1].id" == 2
jsonpath "$[1].surah" == "Al-Baqara"
jsonpath "$[1].arabic" == "ٱلْبَقَرَة"
