<Project Sdk="Microsoft.NET.Sdk">
  <!-- content: Quran, articles, lectures, books. Depends on no other domain. -->
  <PropertyGroup>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="YamlDotNet" />
    <ProjectReference Include="../../../shared/api/Tsr.Shared.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests sit next to the code they test; tests/ compiles them. -->
    <Compile Remove="**/*.Tests.cs" />
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Slices and value objects are internal; this domain's unit tests and the database tests may see them. -->
    <InternalsVisibleTo Include="Tsr.Content.Api.Tests" />
    <InternalsVisibleTo Include="Tsr.Db.Tests" />
  </ItemGroup>
</Project>
