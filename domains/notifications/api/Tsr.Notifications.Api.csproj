<Project Sdk="Microsoft.NET.Sdk">
  <!-- notifications: push, WhatsApp, devices, scheduled notifications, notifier. NotificationsCommands (published); uses platform's queue command and reads identity's v_users. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../../shared/api/Tsr.Shared.Api.csproj" />
    <ProjectReference Include="../../access/api/Tsr.Access.Api.csproj" />
    <ProjectReference Include="../../platform/api/Tsr.Platform.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests sit next to the code they test; tests/ compiles them. -->
    <Compile Remove="**/*.Tests.cs" />
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The context and its tables are internal; this domain's own tests and the database tests may see them. -->
    <InternalsVisibleTo Include="Tsr.Notifications.Api.Tests" />
    <InternalsVisibleTo Include="Tsr.Db.Tests" />
  </ItemGroup>
</Project>
