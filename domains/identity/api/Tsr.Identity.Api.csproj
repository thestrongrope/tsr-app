<Project Sdk="Microsoft.NET.Sdk">
  <!-- identity (AuthN): who is calling. Depends on shared, access (permissions), platform and notifications (their erasure commands). membership is NOT referenced (it references identity): it supplies IMemberErasure. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <ProjectReference Include="../../../shared/api/Tsr.Shared.Api.csproj" />
    <ProjectReference Include="../../access/api/Tsr.Access.Api.csproj" />
    <ProjectReference Include="../../notifications/api/Tsr.Notifications.Api.csproj" />
    <ProjectReference Include="../../platform/api/Tsr.Platform.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests sit next to the code they test; tests/ compiles them. -->
    <Compile Remove="**/*.Tests.cs" />
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Verifier, middleware and slices are internal; this domain's unit tests and the database tests may see them. -->
    <InternalsVisibleTo Include="Tsr.Identity.Api.Tests" />
    <InternalsVisibleTo Include="Tsr.Db.Tests" />
  </ItemGroup>
</Project>
