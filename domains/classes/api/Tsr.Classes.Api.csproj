<Project Sdk="Microsoft.NET.Sdk">
  <!-- classes: classes, levels, enrolment, sessions, teachers, syllabus. Tables only so far; lists no other domain. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../../shared/api/Tsr.Shared.Api.csproj" />
    <ProjectReference Include="../../access/api/Tsr.Access.Api.csproj" />
    <ProjectReference Include="../../platform/api/Tsr.Platform.Api.csproj" />
    <ProjectReference Include="../../membership/api/Tsr.Membership.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- PHP data file web/data/syllabus_topics.json: the topic catalogue by level name (today only MIQDAD). -->
    <EmbeddedResource Include="data/syllabus_topics.json" LogicalName="syllabus_topics.json" />
    <!-- PHP ClassesModel::getTimezones(): the 143 static zone and label pairs. -->
    <EmbeddedResource Include="data/timezones.json" LogicalName="timezones.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests sit next to the code they test; tests/ compiles them. -->
    <Compile Remove="**/*.Tests.cs" />
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The context and its tables are internal; this domain's own tests and the database tests may see them. -->
    <InternalsVisibleTo Include="Tsr.Classes.Api.Tests" />
    <InternalsVisibleTo Include="Tsr.Db.Tests" />
  </ItemGroup>
</Project>
