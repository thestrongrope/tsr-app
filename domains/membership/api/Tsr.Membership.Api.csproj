<Project Sdk="Microsoft.NET.Sdk">
  <!-- membership: members' profiles, registrations, interests, guardians. Lists access, identity and platform as dependencies. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../../shared/api/Tsr.Shared.Api.csproj" />
    <ProjectReference Include="../../access/api/Tsr.Access.Api.csproj" />
    <ProjectReference Include="../../identity/api/Tsr.Identity.Api.csproj" />
    <ProjectReference Include="../../platform/api/Tsr.Platform.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests sit next to the code they test; tests/ compiles them. -->
    <Compile Remove="**/*.Tests.cs" />
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Slices and value objects are internal; this domain's own unit tests and the database tests may see them. -->
    <InternalsVisibleTo Include="Tsr.Membership.Api.Tests" />
    <InternalsVisibleTo Include="Tsr.Db.Tests" />
  </ItemGroup>
</Project>
