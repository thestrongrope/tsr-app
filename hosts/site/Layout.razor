@* The one page frame, as tsr-web's app/layout.tsx: head, header, the page (which writes its own <main>), footer.
   Two scripts only: the before-paint theme snippet, word for word from layout.tsx, and /site.js. No analytics. *@
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Page.Title</title>
    <meta name="description" content="@(Page.Description ?? DefaultDescription)">
    <link rel="icon" href="/icon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="stylesheet" href="/site.css">
    @BeforePaint
</head>
<body>
    <Navigation Menu="Menu" />
    <DynamicComponent Type="Page.Component" Parameters="ToMutable(Page.Parameters)" />
    <Footer />
    @SiteScript
</body>
</html>

@code {
    private const string DefaultDescription = "The Path of the Ahle Bait (a.s.)";

    // Razor refuses a script element written in a component, so the two are fixed texts of this file, never data.
    // The first applies a saved dark preference before paint, so a visitor who chose dark never sees a light flash.
    private static readonly MarkupString BeforePaint = new(
        "<script>(function(){try{if(localStorage.getItem('theme')==='dark'){document.documentElement.classList.add('dark');}}catch(e){/* no storage: fall back to the light default */}})();</script>");

    private static readonly MarkupString SiteScript = new("<script src=\"/site.js\" defer></script>");

    [Parameter, EditorRequired]
    public SitePage Page { get; set; } = default!;

    /// <summary>The categories of the menu, read from the API when the site was built.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<MenuCategory> Menu { get; set; } = default!;

    private static Dictionary<string, object> ToMutable(IReadOnlyDictionary<string, object?> parameters) =>
        parameters.ToDictionary(p => p.Key, p => p.Value!);
}
