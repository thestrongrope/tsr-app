# The server of the generated pages (docker-compose.yml "site"): the stock nginx image with our own configuration file,
# hosts/site/nginx.conf, baked in so the production stack mounts no configuration (hosts/api/tests/ProductionStackTests.cs,
# No_second_proxy). The file answers an unknown address with the site's own page, /404.html (which the generator writes), and
# redirects the addresses of the old website. It forwards nothing. Build context: hosts/site.
#
# Prove it without starting the stack (docs/testing.md):
#   docker build -f hosts/site/Dockerfile.server --target selftest hosts/site

FROM nginx:1.27-alpine AS server
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN nginx -t

# Never run and never shipped: serves stand-in pages inside the build and asks nginx for each rule (selftest.sh).
FROM server AS selftest
COPY selftest.sh /selftest.sh
RUN cd /usr/share/nginx/html \
 && mkdir -p about articles/real-slug .well-known \
 && echo 'stand-in not-found page' > 404.html \
 && echo 'stand-in about page' > about/index.html \
 && echo 'stand-in stylesheet' > site.css \
 && echo 'stand-in article' > articles/real-slug/index.html \
 && echo '{}' > .well-known/apple-app-site-association \
 && nginx \
 && sleep 1 \
 && sh /selftest.sh

FROM server
