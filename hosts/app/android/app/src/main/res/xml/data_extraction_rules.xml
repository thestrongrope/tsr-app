<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the local Hive boxes hold member details
     unencrypted, so neither Google backup nor device-to-device transfer may
     copy them. Android 12+ reads this; allowBackup="false" covers older
     versions. A member on a new phone simply signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
