    <!-- CA1716: "Shared" is a VB keyword. Nothing here is consumed from VB (as in shared/api). -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
