# LOCAL-ONLY placeholders for the parity stack. Not secrets: they guard a throwaway
# database that holds synthetic data only and is never reachable off this machine.
# Real keys, project ids and production URLs must never be put here.

# local-only placeholder: MariaDB root password
PARITY_DB_ROOT_PASSWORD=parity-root-local-only
# local-only placeholder: application database user
PARITY_DB_USER=tsr_user
# local-only placeholder: application database password
PARITY_DB_PASSWORD=parity-app-local-only
# local-only: must start with tsr_synth, the generator refuses any other name
PARITY_DB_NAME=tsr_synth
# local-only: Firebase emulator project; "demo-" is the emulator-only prefix the PHP gate requires
PARITY_FIREBASE_PROJECT_ID=demo-tsr-local
# local-only: host ports, bound to 127.0.0.1
PARITY_API_PORT=18091
PARITY_EMULATOR_PORT=19199
# local-only placeholder: password for the emulator test account (emulator accounts are in memory)
PARITY_EMULATOR_PASSWORD=parity-member-local-only
