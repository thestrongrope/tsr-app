root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# EF Core migrations are generated by `dotnet ef` (db/add-migration.sh): never analyzed, only reviewed as SQL.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
